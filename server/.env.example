# ─────────────────────────────────────────────────────────────
# 네이버 광고 대시보드 서버 설정 (.env)
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 깃·메신저·메일로 공유하지 마세요.
# ─────────────────────────────────────────────────────────────

# 웹
BASE_PATH=/seonhwa_choi/naver
APP_SECRET_KEY=여기에_아무_긴_무작위_문자열_40자이상
SESSION_DAYS=14
# 최초 관리자 (사용자 목록이 비어 있어도 로그인 가능). 쉼표로 여러 명
BOOTSTRAP_ADMIN_EMAILS=
# 사내 로그인(앞단)이 넘겨주는 사용자 이메일 헤더. AI 배포서버는 X-Email (등록된 사용자만 통과)
SSO_EMAIL_HEADER=X-Email

# DB — 같은 docker-compose 의 mariadb 컨테이너 사용
# 비밀번호는 docker-compose.yml 의 MYSQL_ROOT_PASSWORD 와 같게 (특수문자는 URL 인코딩: @ → %40, ! → %21)
DATABASE_URL=mysql+pymysql://root:비밀번호@<유저ID>-mariadb:3306/<유저ID>_db?charset=utf8mb4

# 광고주 키 (권한 범위 구분용)
ADVERTISER_KEY=mars

# 네이버 검색광고 API (searchad.naver.com > 도구 > API 사용 관리)
NAVER_SA_CUSTOMER_ID=
NAVER_SA_API_KEY=
NAVER_SA_SECRET_KEY=
# 네이버 개발자센터 (데이터랩 검색어 트렌드)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# GFA — 사내 게이트웨이 (윤성현님 안내서)
GFA_API_BASE_URL=https://ai.adef.co.kr/sunghyun_yoon/api/v1/public/gfa-proxy/
GFA_API_KEY=
GFA_TEAM_NAME=
GFA_AD_ACCOUNT_NO=
# 아래 3개는 게이트웨이 연결 후 '관리 > GFA 탐색'으로 실제 응답을 보고 채웁니다
GFA_REPORT_PATH=
GFA_REPORT_PARAMS={}
GFA_FIELD_MAP={}

# 구글 (드라이브 업로드 · 로그인 인증코드 메일 · 월예산 시트) — docs/구글토큰_발급가이드.md 참고
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_WEEKLY_FOLDER_ID=
RAW_UPLOAD_FOLDER_ID=
BUDGET_SHEET_ID=
# 소재 이미지 폴더 (드라이브 '마즈_GFA소재이미지' 폴더 ID, 선택)
GFA_IMAGE_FOLDER_ID=

# 일정 (한국시간, cron 형식: 분 시 일 월 요일)
COLLECT_CRON=0 7 * * *
REPORT_CRON=30 13 * * mon
RECOLLECT_DAYS=7
# 월요일 작업 켜기 (1=켜기). 켜면 당월 1일~전일 재수집 → 로우 파일을 드라이브 '로우업로드' 폴더에 올림
REPORT_ENABLED=0
# 서버에서 엑셀까지 작성할 때의 명령 (병행 검증이 끝난 뒤 설정)
REPORT_PIPELINE_CMD=
