# 이 파일을 복사해 .streamlit/secrets.toml 로 저장한 뒤 실제 값을 넣으세요.
# (secrets.toml은 .gitignore 처리되어 깃허브에 올라가지 않습니다)
# Streamlit Cloud에 배포했다면: 앱 > Settings > Secrets 에 아래 내용을 그대로 붙여넣기

# ── 네이버 검색광고 API (searchad.naver.com > 도구 > API 사용 관리) ──
NAVER_SA_CUSTOMER_ID = "광고주 CUSTOMER_ID"
NAVER_SA_API_KEY     = "액세스 라이선스"
NAVER_SA_SECRET_KEY  = "비밀키"

# ── 네이버 개발자센터 애플리케이션 (데이터랩 검색어트렌드) ──
NAVER_CLIENT_ID      = "Client ID"
NAVER_CLIENT_SECRET  = "Client Secret"

# ── 네이버 GFA (대행사 공통키) ──
GFA_API_KEY          = "API 게이트웨이 서버 키"
# 아래 3개는 네이버(agency_cs@navercorp.com)에서 API 규격을 받은 뒤 채우세요. 비워두면 파일 업로드 방식으로 동작합니다.
GFA_API_BASE_URL     = ""
GFA_KEY_HEADER       = ""
GFA_STATS_PATH       = ""
GFA_AD_ACCOUNT_NO    = ""
